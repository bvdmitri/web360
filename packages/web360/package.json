{
  "name": "@bvdmitri/web360",
  "version": "0.4.3",
  "description": "Stitch and stabilize 360 recordings in the browser, on WebGPU and WebCodecs.",
  "license": "MIT",
  "author": "bvdmitri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvdmitri/web360.git",
    "directory": "packages/web360"
  },
  "homepage": "https://github.com/bvdmitri/web360#readme",
  "bugs": {
    "url": "https://github.com/bvdmitri/web360/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node --max-old-space-size=8192 node_modules/tsdown/dist/run.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@webgpu/types": "0.1.74"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "@web360/core": "workspace:*",
    "@web360/webcodecs": "workspace:*",
    "@web360/webgpu": "workspace:*",
    "tsdown": "0.23.0",
    "vitest": "4.1.11",
    "webgpu": "0.6.1"
  },
  "keywords": [
    "360",
    "equirectangular",
    "stitch",
    "stabilization",
    "insta360",
    "gopro",
    "webgpu",
    "webcodecs"
  ],
  "publishConfig": {
    "access": "public"
  }
}
